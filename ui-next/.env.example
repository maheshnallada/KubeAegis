# ──────────────────────────────────────────────────────────────────────────────
# React UI — environment variables
#
# For LOCAL DEV:
#   Copy this file to .env.local and fill in values.
#   Vite picks up .env.local automatically.
#
# For REPLIT:
#   Add VITE_BACKEND_URL in the Replit Secrets tab — do NOT create .env.local
#   on Replit; Replit injects secrets as process env vars at build/run time.
#
# For VERCEL:
#   Add VITE_BACKEND_URL in Project Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────────────────────

# URL of the FastAPI backend.
# Leave empty to use the Vite dev-server proxy (/api → localhost:8000).
VITE_BACKEND_URL=
